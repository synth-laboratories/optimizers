/target
**/target
.venv/
__pycache__/
*.pyc
*.abi3.so
.ruff_cache/
.env

# Editor / IDE — local workspace files only.
*.code-workspace
.cursor/

# Local board/console artifacts and scratch run dirs.
gepa_board.html
/runs/

# Local dev examples — keep bulky runs on disk, but track Better GEPA acceptance replay.
dev_examples/
!dev_examples/
dev_examples/*
!dev_examples/better_gepa/
dev_examples/better_gepa/*
!dev_examples/better_gepa/run_acceptance.py
!dev_examples/better_gepa/acceptance_usage_termination.md
!dev_examples/better_gepa/profiles/
dev_examples/better_gepa/profiles/*
!dev_examples/better_gepa/profiles/banking77_openai_baseline.toml
!dev_examples/better_gepa/profiles/banking77_openai_baseline_docker.toml
!dev_examples/better_gepa/profiles/banking77_openrouter_grok43.toml
!dev_examples/better_gepa/profiles/banking77_openrouter_grok43_docker.toml
!dev_examples/better_gepa/profiles/banking77_openrouter_nemotron_ultra.toml
!dev_examples/better_gepa/profiles/banking77_nvidia_nemotron_ultra.toml
!dev_examples/online_reflexion/
dev_examples/online_reflexion/*
!dev_examples/online_reflexion/native_smoke.json
!dev_examples/online_reflexion/evidence_notes_template.json
!dev_examples/online_reflexion/release_blog_growth_plan.md
